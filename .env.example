# OffLoop AI Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=true

# AI Provider: "ollama", "hosted_gemma", or "fallback"
AI_PROVIDER=ollama

# Ollama Local Settings (Recommended: gemma2:2b or gemma3:4b)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma2:2b

# Hosted Gemma / Open-Weight Endpoint (Optional)
HOSTED_GEMMA_ENDPOINT=https://api.example.com/v1/chat/completions
HOSTED_GEMMA_API_KEY=your_api_key_here
HOSTED_GEMMA_MODEL=google/gemma-2-9b-it

# OpenStreetMap / Overpass Endpoint
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=25

# Optional: ElevenLabs Voice Narration (Backend proxy only)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Security & CORS
ALLOWED_ORIGINS=*
API_V1_PREFIX=/api/v1
