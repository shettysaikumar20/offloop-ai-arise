# ==========================================
# OFFLOOP AI: ARISE — .gitignore
# ==========================================

# Dependencies & Build Outputs
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/

# Python & Backend
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
ENV/
.pytest_cache/
.coverage
htmlcov/
*.sqlite3
*.db

# Environment & Secrets (Preserve .env.example)
.env
*.env
!.env.example
*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Operating System & Editor Files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
*.bak

# Legacy build artifacts
*.apk
*.aab
.gradle/
local.properties
